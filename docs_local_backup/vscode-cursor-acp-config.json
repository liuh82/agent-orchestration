# VS Code / Cursor ACP 配置文件
# 
# 使用说明：
# 1. 将此文件内容复制到：
#    - Cursor:  ~/.cursor/mcp.json
#    - VS Code: ~/.vscode/mcp.json (或项目 .vscode/mcp.json)
# 2. 确保已安装 openclaw CLI: npm install -g openclaw
# 3. 确保已配置 Gateway Token: ~/.openclaw/gateway.token
# 4. 重启 IDE

{
  "servers": {
    "openclaw-acp": {
      "type": "stdio",
      "command": "openclaw",
      "args": [
        "acp",
        "--url", "wss://81.70.98.45:9443/acp-ws",
        "--token-file", "~/.openclaw/gateway.token",
        "--session", "agent:main:main",
        "--no-prefix-cwd"
      ],
      "env": {
        "OPENCLAW_HIDE_BANNER": "1",
        "OPENCLAW_SUPPRESS_NOTES": "1"
      }
    }
  }
}
