# Nexus Backend — Environment Variables
# Copy this file to .env and customize

# Database (SQLite for local, PostgreSQL for cloud)
DATABASE_URL=sqlite:///./data/nexus.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/nexus

# JWT Authentication
JWT_SECRET=change-this-to-a-random-string
JWT_ACCESS_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# First-run admin account (email must use a valid public TLD)
ADMIN_EMAIL=admin@nexus.dev
ADMIN_PASSWORD=changeme

# Legacy API Key Authentication (comma-separated, used by heartbeats/gateway)
API_KEYS=
ADMIN_API_KEYS=

# Gateway WebSocket
GATEWAY_WS_PORT=8765
GATEWAY_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
