# Remote Agent Bridge — Environment Variables
# Copy this file to .env and customize
# These override the default JSON config (config.json) when set.

# ── Bridge Identity ───────────────────────────────────────
OC_BRIDGE_ID=
OC_BRIDGE_NAME=

# ── Gateway Connection ────────────────────────────────────
OC_GATEWAY_URL=wss://your-gateway-host:18789
OC_GATEWAY_TOKEN=your-gateway-token-here
OC_GATEWAY_HEARTBEAT_INTERVAL=30000

# ── Task Execution ────────────────────────────────────────
OC_TASKS_MAX_CONCURRENT=3
OC_TASKS_DEFAULT_TIMEOUT=300

# ── HTTP Server ───────────────────────────────────────────
OC_HTTP_ENABLED=true
OC_HTTP_HOST=127.0.0.1
OC_HTTP_PORT=18790
OC_HTTP_API_KEY=

# ── Logging ───────────────────────────────────────────────
OC_LOG_LEVEL=info

# ── Storage ───────────────────────────────────────────────
OC_DATABASE_PATH=
OC_CHECKPOINT_ENABLED=true

# ── Security ──────────────────────────────────────────────
OC_SANDBOX_ENABLED=true
