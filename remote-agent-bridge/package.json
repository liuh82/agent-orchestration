{
  "name": "@liuh82/oc-bridge",
  "version": "0.1.0",
  "description": "Remote Agent Bridge - Cross-platform bridge for AI Agent orchestration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "oc-bridge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "bridge",
    "websocket",
    "ai",
    "openclaw",
    "claude-code",
    "remote"
  ],
  "author": "liuh82",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "minimatch": "^10.2.4",
    "uuid": "^9.0.1",
    "which": "^4.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "@types/which": "^2.0.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
